{
  "name": "@shanhai/kaipu-wisdom-team",
  "version": "0.1.0",
  "type": "module",
  "description": "山海·开铺 · 智囊团插件 —— 开铺（kaipu-platform）的配套侧边面板：展示「我方内置的这群谋士」是谁、服务哪些场景，以及席位待接入状态。★ 需配合 kaipu-platform 安装 —— 灯位数据由开铺插件经宿主网关提供，单独安装会如实显示「通道未就绪」。★ 可摘除：卸掉它，开铺仍完整可用（可替换成你自己的 Agent 团队）。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanhai-city-states/kaipu-dsh-plugin-site.git",
    "directory": "packages/plugin-wisdom"
  },
  "icon": "icon.svg",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "kaipu",
    "wisdom",
    "panel"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "kaipu": {
    "dshRange": ">=0.2.0-rc.2 <0.3.0",
    "declaredSurfaces": [
      "ui.panel",
      "ui.slot",
      "data.local"
    ],
    "//": "本块是本仓自有声明，DSH 官方不读；仅用于说明本包的兼容范围与对外能力面。"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.3.1"
  }
}
