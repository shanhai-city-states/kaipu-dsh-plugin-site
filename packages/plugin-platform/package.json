{
  "name": "@shanhai/kaipu-platform",
  "version": "0.1.4",
  "type": "module",
  "description": "山海·开铺 · 场地插件（核心）—— 开铺审计的场地面板：场景／运行记录与运行视图／报告两栏。★ 审计数据需配合山海服务端使用。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanhai-city-states/kaipu-dsh-plugin-site.git",
    "directory": "packages/plugin-platform"
  },
  "icon": "icon.svg",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "kaipu",
    "audit",
    "store-opening",
    "workflow"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "kaipu": {
    "dshRange": ">=0.2.0-rc.2 <0.3.0",
    "declaredSurfaces": [
      "ui.panel",
      "ui.slot",
      "data.local"
    ],
    "//": "本块是本仓自有声明，DSH 官方不读；仅用于说明本包的兼容范围与对外能力面。"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.3.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2 || ^0.2.0"
  }
}
