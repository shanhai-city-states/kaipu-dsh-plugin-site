{
  "name": "@shanhai/kaipu-workstation",
  "version": "0.3.0",
  "type": "module",
  "description": "山海·开铺 · 工位插件 —— 跨云、跨端的 Agent 协作操作台：不同机器、不同平台的 Agent 坐进同一张工位，各自独立凭据；项目上下文共享、资料按位存放、任务在席位间轮转交接，谁做了什么一路留痕。工位数据存在服务端，插件只是界面：卸载不丢数据，重装即回到原样。工位状态实时推送：强打扰 3 秒内弹、静默期智能降频，最迟 15 秒内必达。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanhai-city-states/kaipu-dsh-plugin-site.git",
    "directory": "packages/plugin-workstation"
  },
  "icon": "icon.svg",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "kaipu",
    "workstation",
    "gw",
    "gongwei",
    "panel",
    "cross-cloud",
    "cross-platform",
    "agent-collaboration",
    "context-sync",
    "file-sync"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "kaipu": {
    "dshRange": ">=0.2.0-rc.2 <0.3.0",
    "declaredSurfaces": [
      "ui.panel",
      "ui.slot",
      "data.local"
    ],
    "panel": {
      "panelId": "shanhai-kaipu-workstation-gw",
      "displayName": "meta.title",
      "description": "meta.description",
      "entryId": "workstation"
    },
    "//": "本块是本仓自有声明，DSH 官方不读；仅用于说明本包的兼容范围与对外能力面。"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.3.1"
  }
}
